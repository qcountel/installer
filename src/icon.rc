// Minecraft Installer resources
#include <winres.h>

#define IDI_ICON1 101

IDI_ICON1 ICON "icon\\icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Minecraft Installer"
            VALUE "ProductName", "Minecraft Installer"
            VALUE "InternalName", "MinecraftInstaller"
            VALUE "OriginalFilename", "Minecraft Installer.exe"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
